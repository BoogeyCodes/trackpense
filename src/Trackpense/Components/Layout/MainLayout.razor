@inherits LayoutComponentBase

<div class="layout">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand__mark">₵</span>
            <span class="brand__name">Trackpense</span>
        </div>
        <NavMenu />
    </aside>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
